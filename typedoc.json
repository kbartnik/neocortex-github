{
  "entryPoints": ["src/index.ts"],
  "outputs": [
    {
      "name": "markdown",
      "path": "./docs/api/md"
    },
    {
      "name": "html",
      "path": "./docs/api/html"
    }
  ],
  "plugin": ["typedoc-plugin-markdown"],
  "outputFileStrategy": "Members",
  "entryFileName": "index.md",
  "readme": "none",
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "hideGenerator": true,
  "includeVersion": true,
  "gitRevision": "main"
}
